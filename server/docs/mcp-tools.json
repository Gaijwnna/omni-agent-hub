  {
    "name": "draft_flight_claim",
    "description": "Generate a flight-delay letter in memory. Not legal advice; never sends or stores the claim.",
    "input_schema": {
      "$defs": {
        "Claim": {
          "additionalProperties": false,
          "properties": {
            "passenger": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Passenger",
              "type": "string"
            },
            "address": {
              "maxLength": 1000,
              "minLength": 1,
              "title": "Address",
              "type": "string"
            },
            "email": {
              "maxLength": 254,
              "minLength": 3,
              "title": "Email",
              "type": "string"
            },
            "airline": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Airline",
              "type": "string"
            },
            "airline_address": {
              "maxLength": 1000,
              "minLength": 1,
              "title": "Airline Address",
              "type": "string"
            },
            "flight_number": {
              "maxLength": 20,
              "minLength": 2,
              "title": "Flight Number",
              "type": "string"
            },
            "flight_date": {
              "format": "date",
              "title": "Flight Date",
              "type": "string"
            },
            "booking_reference": {
              "maxLength": 30,
              "minLength": 1,
              "title": "Booking Reference",
              "type": "string"
            },
            "departure": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Departure",
              "type": "string"
            },
            "arrival": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Arrival",
              "type": "string"
            },
            "distance_km": {
              "exclusiveMinimum": 0,
              "maximum": 22000,
              "title": "Distance Km",
              "type": "integer"
            },
            "arrival_delay_minutes": {
              "maximum": 10080,
              "minimum": 0,
              "title": "Arrival Delay Minutes",
              "type": "integer"
            },
            "regime": {
              "enum": [
                "UK261",
                "EU261"
              ],
              "title": "Regime",
              "type": "string"
            },
            "departure_jurisdiction": {
              "enum": [
                "UK",
                "EU",
                "other"
              ],
              "title": "Departure Jurisdiction",
              "type": "string"
            },
            "arrival_jurisdiction": {
              "enum": [
                "UK",
                "EU",
                "other"
              ],
              "title": "Arrival Jurisdiction",
              "type": "string"
            },
            "operating_carrier": {
              "enum": [
                "UK",
                "EU",
                "other"
              ],
              "title": "Operating Carrier",
              "type": "string"
            },
            "extraordinary_circumstances": {
              "default": "unknown",
              "enum": [
                "no",
                "yes",
                "unknown"
              ],
              "title": "Extraordinary Circumstances",
              "type": "string"
            },
            "details": {
              "maxLength": 5000,
              "minLength": 1,
              "title": "Details",
              "type": "string"
            }
          },
          "required": [
            "passenger",
            "address",
            "email",
            "airline",
            "airline_address",
            "flight_number",
            "flight_date",
            "booking_reference",
            "departure",
            "arrival",
            "distance_km",
            "arrival_delay_minutes",
            "regime",
            "departure_jurisdiction",
            "arrival_jurisdiction",
            "operating_carrier",
            "details"
          ],
          "title": "Claim",
          "type": "object"
        }
      },
      "properties": {
        "claim": {
          "$ref": "#/$defs/Claim"
        }
      },
      "required": [
        "claim"
      ],
      "title": "draft_flight_claimArguments",
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": true,
      "title": "draft_flight_claimDictOutput",
      "type": "object"
    },
    "annotations": {
      "read_only_hint": true,
      "destructive_hint": false,
      "open_world_hint": false
    }
  },
